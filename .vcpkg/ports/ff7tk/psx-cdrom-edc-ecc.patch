+bool IsoArchiveIO::updateSectorEdcEcc(QByteArray &sectorData, bool updateForm2Edc)
+{
+    if (sectorData.size() != SECTOR_SIZE) {
+        return false;
+    }
+
+    auto *sector = reinterpret_cast<quint8 *>(sectorData.data());
+    if (!hasCdRomSync(sector)) {
+        return true;
+    }
+
+    const quint8 mode = sector[15];
+    if (mode == 1) {
+        const quint32 edc = computeEdc(sector, MODE1_EDC_OFFSET);
+        writeEdcLittleEndian(sector + MODE1_EDC_OFFSET, edc);
+        std::memset(sector + MODE1_EDC_OFFSET + 4, 0, 8);
+        computeEcc(sector + 12, 86, 24, 2, 86, sector + ECC_P_OFFSET);
+        computeEcc(sector + 12, 52, 43, 86, 88, sector + ECC_Q_OFFSET);
+        return true;
+    }
+
+    if (mode != 2) {
+        return true;
+    }
+
+    // CD-ROM XA repeats its four-byte subheader. If this is a plain Mode 2
+    // sector, it has no EDC/ECC fields for us to regenerate.
+    if (std::memcmp(sector + 16, sector + 20, 4) != 0) {
+        return true;
+    }
+
+    // Mode 2 Form 2 has 2324 user bytes plus an EDC, but no P/Q ECC.
+    // When relocating an existing raw sector we can preserve its original
+    // EDC because the EDC does not cover the MSF address in bytes 12..14.
+    if ((sector[18] & 0x20U) != 0) {
+        if (updateForm2Edc) {
+            const quint32 edc = computeEdc(sector + 16, MODE2_FORM2_EDC_OFFSET - 16);
+            writeEdcLittleEndian(sector + MODE2_FORM2_EDC_OFFSET, edc);
+        }
+        return true;
+    }
+
+    // Mode 2 Form 1: EDC covers the duplicated XA subheader plus 2048 bytes
+    // of user data (bytes 16..2071). P/Q parity follows the EDC.
+    const quint32 edc = computeEdc(sector + 16, MODE2_FORM1_EDC_OFFSET - 16);
+    writeEdcLittleEndian(sector + MODE2_FORM1_EDC_OFFSET, edc);
+
+    // For XA Form 1 the address/mode bytes are treated as zero while the
+    // RSPC P/Q parity is generated. Restore them after both parity passes.
+    quint8 header[4];
+    std::memcpy(header, sector + 12, sizeof(header));
+    std::memset(sector + 12, 0, sizeof(header));
+    computeEcc(sector + 12, 86, 24, 2, 86, sector + ECC_P_OFFSET);
+    computeEcc(sector + 12, 52, 43, 86, 88, sector + ECC_Q_OFFSET);
+    std::memcpy(sector + 12, header, sizeof(header));
+
+    return true;
+}
+
+bool IsoArchiveIO::repairSector(quint32 num)
+{
+    const qint64 previousPos = pos();
+    const qint64 sectorPos = qint64(num) * SECTOR_SIZE;
+
+    if (!seek(sectorPos)) {
+        return false;
+    }
+
+    QByteArray sectorData = read(SECTOR_SIZE);
+    bool ok = sectorData.size() == SECTOR_SIZE && updateSectorEdcEcc(sectorData);
+
+    if (ok) {
+        ok = seek(sectorPos) && write(sectorData) == SECTOR_SIZE;
+    }
+
+    if (!seek(previousPos)) {
+        ok = false;
+    }
+    return ok;
+}
+
+bool IsoArchiveIO::writeRepairedSector(QByteArray sectorData)
+{
+    if (sectorData.size() != SECTOR_SIZE || pos() % SECTOR_SIZE != 0) {
+        return false;
+    }
+
+    auto *sector = reinterpret_cast<quint8 *>(sectorData.data());
+    if (hasCdRomSync(sector) && (sector[15] == 1 || sector[15] == 2)) {
+        const QByteArray address = int2Header(currentSector());
+        std::memcpy(sector + 12, address.constData(), 3);
+        if (!updateSectorEdcEcc(sectorData, false)) {
+            return false;
+        }
+    }
+
+    return write(sectorData) == SECTOR_SIZE;
+}
